PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sandeshak

REDIS_URL=redis://:redispass@localhost:6379

# Access tokens are JWT (15-min TTL by default).
# Refresh tokens are opaque random bytes stored in Redis with TTL set in code
# (30 days, see src/lib/refresh-tokens.ts) — not signed, so no JWT_REFRESH_*.
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m

CLIENT_WEB_URL=http://localhost:5173
CLIENT_MOBILE_URL=exp://localhost:8081

# Email (Nodemailer). Leave blank in dev — the mailer logs to stdout instead.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@sandeshak.app

# S3 / MinIO. The same endpoint is used internally AND embedded into presigned
# URLs sent to clients. For a physical mobile device to upload, set this to the
# dev machine's LAN IP (e.g. http://192.168.1.42:9000) — localhost won't work.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=sandeshak
