PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sandeshak

REDIS_URL=redis://:redispass@localhost:6379

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

CLIENT_WEB_URL=http://localhost:5173
CLIENT_MOBILE_URL=exp://localhost:8081

# Email (Nodemailer)
